{
  "name": "stat-viewer2",
  "private": true,
  "homepage": "https://defitracker.github.io/stat-viewer2/",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "dev": "vite --port 4444",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:iter2": "esbuild test/iter2.smoke.tsx --bundle --platform=node --format=cjs --outfile=test/.build/iter2.smoke.cjs --alias:@=./src --alias:@microlink/react-json-view=./test/stub-react-json-view.tsx --external:sql.js --jsx=automatic --log-level=warning && node test/.build/iter2.smoke.cjs",
    "test:browser": "node test/browser.smoke.mjs",
    "test": "npm run test:iter2 && npm run test:browser"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@hookform/resolvers": "^5.7.1",
    "@microlink/react-json-view": "^1.31.28",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "ag-grid-community": "^36.1.0",
    "ag-grid-enterprise": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "bignumber.js": "^11.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "function-plot": "^1.25.4",
    "idb": "^8.0.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.0",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "gh-pages": "^6.3.0",
    "globals": "^17.9.0",
    "puppeteer-core": "^25.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vite-plugin-pages": "^0.33.3"
  }
}
